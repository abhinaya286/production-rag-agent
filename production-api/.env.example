# Required at runtime
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Provide DATABASE_URL or the Supabase fields below.
# URL-encode special characters in the username/password.
DATABASE_URL=
SUPABASE_HOST=
SUPABASE_PORT=5432
SUPABASE_DATABASE=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=
VECTOR_COLLECTION_NAME=production_documents

# Required when APP_ENV=production. Optional in development.
API_ACCESS_TOKEN=
APP_ENV=development
LOG_LEVEL=INFO
RATE_LIMIT=20/minute

# Retrieval and chunking
RETRIEVAL_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
CACHE_TTL_SECONDS=300

PRIMARY_MODEL=gemini-2.5-flash
FALLBACK_MODEL=gemini-2.5-pro
EMBEDDING_MODEL=gemini-embedding-001

# Optional tracing. This sends prompts and retrieved context to LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=production-rag
